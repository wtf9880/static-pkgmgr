#!/usr/bin/env bash
# tests/fixtures/fakebin/curl -- offline test double for `curl`.
#
# Serves canned fixture data for static-pkgmgr recipe URLs (the GitHub releases
# API, the nodejs.org dist index, SHASUMS256.txt, and the canned archive
# downloads) so Phase-4 recipes and the github helper can be exercised without
# network access. file:// URLs and any unrecognised URL are passed through to
# the real curl. Used ONLY by tests; not part of the package (no .sh suffix,
# so CI's shellcheck glob skips it).
#
# Fixtures root is $SPM_FAKE_FIXTURES (set up by the tests that use this).
set -Eeuo pipefail

# Find the real curl (this directory is prepended to PATH during tests, so the
# first `curl` on PATH is this script).
real_curl=""
while IFS= read -r line; do
	case "$line" in
		*"$0"*) ;;               # skip this fake script
		*) real_curl="$line"; break ;;
	esac
done < <(type -aP curl 2>/dev/null)
if [ -z "$real_curl" ]; then
	printf 'fakebin/curl: no real curl found on PATH\n' >&2
	exit 127
fi

fx="${SPM_FAKE_FIXTURES:-}"

# Pull the URL out of the arguments (the first http/https/file argument).
url=""
for a in "$@"; do
	case "$a" in
		http://*|https://*|file://*) url="$a" ;;
	esac
done
if [ -z "$url" ]; then
	exec "$real_curl" "$@"
fi

# file:// URLs (and anything we do not recognise) hit the real network-less curl.
case "$url" in
	file://*) exec "$real_curl" "$@" ;;
esac

# Detect a HEAD request: a short-option group containing 'I' (-I, -sIL, ...).
head=0
for a in "$@"; do
	case "$a" in -*I*) head=1 ;; esac
done

# Parse curl's -o <file> (write body to this file instead of stdout), in both the
# "-o file" (two-arg) and "-ofile" (one-arg) forms. Existing callers that do not
# use -o leave out_file empty, preserving the original stdout behavior.
out_file=""
_spm_next_out=0
for a in "$@"; do
	if [ "$_spm_next_out" = 1 ]; then
		out_file="$a"
		_spm_next_out=0
	elif [ "$a" = "-o" ]; then
		_spm_next_out=1
	elif [ "${a#-o}" != "$a" ] && [ "$a" != "-o" ]; then
		out_file="${a#-o}"
	fi
done

# Serve an archive/binary fixture: HEAD -> Content-Length header, GET -> bytes
# (to stdout, or to the -o target when the caller requested it).
serve_archive() {
	local file="$1"
	if [ "$head" = 1 ]; then
		printf 'HTTP/1.1 200 OK\r\nContent-Length: %s\r\n\r\n' "$(wc -c < "$file")"
	elif [ -n "$out_file" ]; then
		cat "$file" >"$out_file"
	else
		cat "$file"
	fi
}

case "$url" in
	*api.github.com/repos/ginuerzh/gost/releases*)
		if [ -n "$fx" ] && [ -f "$fx/gost-releases.json" ]; then
			cat "$fx/gost-releases.json"; exit 0
		fi
		;;
	*api.github.com/repos/vi/websocat/releases*)
		if [ -n "$fx" ] && [ -f "$fx/websocat-releases.json" ]; then
			cat "$fx/websocat-releases.json"; exit 0
		fi
		;;
	*api.github.com/repos/pythops/tmux-linux-binary/releases*)
		if [ -n "$fx" ] && [ -f "$fx/tmux-linux-binary-releases.json" ]; then
			cat "$fx/tmux-linux-binary-releases.json"; exit 0
		fi
		;;
	*api.github.com/repos/neovim/neovim/releases*)
		if [ -n "$fx" ] && [ -f "$fx/neovim-releases.json" ]; then
			cat "$fx/neovim-releases.json"; exit 0
		fi
		;;
	*api.github.com/repos/*/releases*)
		if [ -n "$fx" ] && [ -f "$fx/ripgrep-releases.json" ]; then
			cat "$fx/ripgrep-releases.json"; exit 0
		fi
		;;
	*nodejs.org/dist/index.json*)
		if [ -n "$fx" ] && [ -f "$fx/nodejs-index.json" ]; then
			cat "$fx/nodejs-index.json"; exit 0
		fi
		;;
	*nodejs.org/dist/*/SHASUMS256.txt*)
		if [ -n "$fx" ] && [ -f "$fx/nodejs-SHASUMS256.txt" ]; then
			cat "$fx/nodejs-SHASUMS256.txt"; exit 0
		fi
		;;
	*nodejs.org/dist/*/node-v*-linux-*.tar.xz)
		if [ -n "$fx" ] && [ -f "$fx/phase4node.tar.xz" ]; then
			serve_archive "$fx/phase4node.tar.xz"; exit 0
		fi
		;;
	*github.com/*/releases/download/*ripgrep*.tar.gz)
		if [ -n "$fx" ] && [ -f "$fx/phase4rg.tar.gz" ]; then
			serve_archive "$fx/phase4rg.tar.gz"; exit 0
		fi
		;;
	*github.com/neovim/neovim/releases/download/*nvim-linux-*.tar.gz)
		if [ -n "$fx" ] && [ -f "$fx/phase4nvim.tar.gz" ]; then
			serve_archive "$fx/phase4nvim.tar.gz"; exit 0
		fi
		;;
	*github.com/ginuerzh/gost/releases/download/*/checksums.txt)
		if [ -n "$fx" ] && [ -f "$fx/gost-checksums.txt" ]; then
			cat "$fx/gost-checksums.txt"; exit 0
		fi
		;;
	*github.com/ginuerzh/gost/releases/download/*gost*.tar.gz)
		if [ -n "$fx" ] && [ -f "$fx/phase4gost.tar.gz" ]; then
			serve_archive "$fx/phase4gost.tar.gz"; exit 0
		fi
		;;
	*github.com/vi/websocat/releases/download/*websocat*)
		if [ -n "$fx" ] && [ -f "$fx/phase4websocat" ]; then
			serve_archive "$fx/phase4websocat"; exit 0
		fi
		;;
	*github.com/pythops/tmux-linux-binary/releases/download/*tmux-linux*)
		if [ -n "$fx" ] && [ -f "$fx/phase4tmux" ]; then
			serve_archive "$fx/phase4tmux"; exit 0
		fi
		;;
	*go.dev/dl/*mode=json*)
		if [ -n "$fx" ] && [ -f "$fx/golang-dl.json" ]; then
			cat "$fx/golang-dl.json"; exit 0
		fi
		;;
	*go.dev/dl/go*.tar.gz)
		if [ -n "$fx" ] && [ -f "$fx/phase4golang.tar.gz" ]; then
			serve_archive "$fx/phase4golang.tar.gz"; exit 0
		fi
		;;
esac

# Unrecognised https URL: fall back to the real curl (network).
exec "$real_curl" "$@"
